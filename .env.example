# Токен вашего Telegram-бота (от @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...

# Пароль для входа в мини-админку (необязательно, если пусто — вход свободный)
ADMIN_PASSWORD=

# Ссылка на Google Таблицу по умолчанию (можно также менять прямо в интерфейсе)
DEFAULT_SHEET_URL=

# На Vercel для постоянного авто-сохранения новых чатов из вебхука (Upstash Redis / Vercel KV)
# При подключении хранилища Upstash Redis в панели Vercel эти переменные добавятся автоматически:
KV_REST_API_URL=
KV_REST_API_TOKEN=

